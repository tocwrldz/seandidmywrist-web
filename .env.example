# ==============================================================================
# SEANDIDMYWRIST — ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANT:
# - Variables starting with VITE_ are embedded into the client-side JavaScript bundle
#   by Vite during build and are PUBLICLY VISIBLE in the browser.
# - Variables WITHOUT the VITE_ prefix are SENSITIVE / SERVER-SIDE ONLY.
#   Never prefix private keys with VITE_! Configure server keys in Supabase Edge
#   Functions or backend server environment secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Database, Authentication & Storage)
# ------------------------------------------------------------------------------
# [CLIENT-SAFE] Project API URL for connecting to Supabase client
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# [CLIENT-SAFE] Anonymous public API key (guarded by Row Level Security policies)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 2. STRIPE (Payments & Deposits)
# ------------------------------------------------------------------------------
# [CLIENT-SAFE] Stripe Publishable Key for client checkout / Stripe Elements
VITE_STRIPE_PUBLIC_KEY="pk_test_51... or pk_live_51..."

# [CRITICAL: SENSITIVE - SERVER / EDGE FUNCTIONS ONLY - NEVER EXPOSE IN CLIENT]
# Secret API key used to create payment intents, process refunds, and query balance
STRIPE_SECRET_KEY="sk_test_51... or sk_live_51..."

# [CRITICAL: SENSITIVE - SERVER / EDGE FUNCTIONS ONLY - NEVER EXPOSE IN CLIENT]
# Signing secret from Stripe Webhooks dashboard to verify incoming webhook payloads
STRIPE_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------------------------
# 3. RESEND (Transactional Email)
# ------------------------------------------------------------------------------
# [CRITICAL: SENSITIVE - SERVER / EDGE FUNCTIONS ONLY - NEVER EXPOSE IN CLIENT]
# API key to send verified order confirmations, deposit hold notices, and shipping tracking
RESEND_API_KEY="re_123456789_..."

# ------------------------------------------------------------------------------
# 4. TWILIO (SMS Notifications & Order Alerts)
# ------------------------------------------------------------------------------
# [CRITICAL: SENSITIVE - SERVER / EDGE FUNCTIONS ONLY - NEVER EXPOSE IN CLIENT]
# Twilio Account SID
TWILIO_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# [CRITICAL: SENSITIVE - SERVER / EDGE FUNCTIONS ONLY - NEVER EXPOSE IN CLIENT]
# Twilio Auth Token
TWILIO_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 5. OPENAI / AI STUDIO (AI Lab Shopping Assistant)
# ------------------------------------------------------------------------------
# [CRITICAL: SENSITIVE - SERVER / EDGE FUNCTIONS ONLY - NEVER EXPOSE IN CLIENT]
# Used exclusively inside Supabase Edge Function `shop-assistant` or server proxy
OPENAI_API_KEY="sk-proj-..."

# [OPTIONAL / ALTERNATIVE] Gemini API Key for server-side assistant
GEMINI_API_KEY="AIzaSy..."

# [HOSTING / RUNTIME]
APP_URL="https://seandidmywrist.vercel.app"
